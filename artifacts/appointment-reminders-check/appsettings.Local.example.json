{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Initial Catalog=PhongTroDB;User ID=sa;Password=<SQL_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "<JWT_SECRET_AT_LEAST_32_CHARACTERS>",
    "Issuer": "PhongTroAPI",
    "Audience": "PhongTroApp",
    "ExpireHours": 24
  },
  "Firebase": {
    "ProjectId": "<FIREBASE_PROJECT_ID>",
    "CredentialPath": "<ABSOLUTE_PATH_TO_FIREBASE_ADMIN_JSON>"
  },
  "Cloudinary": {
    "CloudName": "<CLOUD_NAME>",
    "ApiKey": "<API_KEY>",
    "ApiSecret": "<API_SECRET>",
    "UploadPreset": "phongtro_unsigned",
    "ListingUploadPreset": "phongtro_listing_unsigned",
    "AvatarUploadPreset": "phongtro_avatar_unsigned",
    "ChatUploadPreset": "phongtro_chat_unsigned"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "<SENDER_EMAIL>",
    "SenderPassword": "<APP_PASSWORD>",
    "SenderName": "Swings House"
  },
  "Translation": {
    "Gemini": {
      "ApiKey": "<GEMINI_API_KEY>"
    }
  },
  "AiChat": {
    "Gemini": {
      "ApiKey": "<GEMINI_API_KEY>"
    }
  },
  "PayOS": {
    "ClientId": "<CLIENT_ID>",
    "ApiKey": "<API_KEY>",
    "ChecksumKey": "<CHECKSUM_KEY>",
    "ReturnUrl": "http://localhost:61795/payment/payos/return",
    "CancelUrl": "http://localhost:61795/payment/payos/cancel"
  },
  "SmsSettings": {
    "Provider": "Stringee",
    "RequireRealDelivery": false,
    "Stringee": {
      "ApiSid": "<API_SID>",
      "ApiSecret": "<API_SECRET>",
      "Brandname": "Stringee"
    }
  }
}

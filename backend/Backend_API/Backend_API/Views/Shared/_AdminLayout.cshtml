@{
    var adminName = User?.Identity?.IsAuthenticated == true
        ? (User.Identity?.Name ?? "Admin")
        : "Admin";
    var pageTitle = ViewData["Title"] as string ?? "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .admin-sidebar {
            min-height: 100vh;
            background: #212529;
        }

        .admin-sidebar .nav-link {
            color: #ced4da;
            border-radius: .5rem;
            margin-bottom: .25rem;
        }

        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            background: #343a40;
            color: #fff;
        }

        .admin-content {
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-12 col-md-3 col-lg-2 p-3 admin-sidebar">
                <a class="d-block text-white text-decoration-none fw-semibold fs-5 mb-4" href="#">
                    Quản trị hệ thống
                </a>

                <nav class="nav flex-column">
                    <a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Tổng quan</a>
                    <a class="nav-link" href="/admin/users"><i class="bi bi-people me-2"></i>Người dùng</a>
                    <a class="nav-link" href="/admin/listings"><i class="bi bi-house-door me-2"></i>Tin đăng</a>
                    <a class="nav-link" href="/admin/reports"><i class="bi bi-flag me-2"></i>Báo cáo</a>
                    <a class="nav-link" href="/admin/payments"><i class="bi bi-credit-card me-2"></i>Thanh toán</a>
                    <a class="nav-link" href="/admin/settings"><i class="bi bi-gear me-2"></i>Cài đặt</a>
                </nav>
            </aside>

            <div class="col-12 col-md-9 col-lg-10 admin-content">
                <header class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
                    <h1 class="h5 mb-0">@pageTitle</h1>

                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted">Xin chào, <strong>@adminName</strong></span>
                        <form method="post" action="/auth/logout" class="m-0">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </button>
                        </form>
                    </div>
                </header>

                <main class="p-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{
    var adminName = User?.Identity?.IsAuthenticated == true
        ? (User.Identity?.Name ?? "Admin")
        : "Admin";
    var pageTitle = ViewData["Title"] as string ?? "Admin";
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    string Active(string url) => path.StartsWith(url) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Swings House Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --admin-bg: #f4f6f8;
            --admin-sidebar: #111827;
            --admin-sidebar-muted: #9ca3af;
            --admin-primary: #0d6efd;
        }

        body { background: var(--admin-bg); }
        .container-fluid { padding-left: 0; padding-right: 0; }
        .admin-shell { min-height: 100vh; }
        .admin-sidebar {
            min-height: 100vh;
            background: var(--admin-sidebar);
            position: sticky;
            top: 0;
        }
        .admin-brand {
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .35rem .25rem 1rem;
        }
        .admin-brand:hover { color: #fff; }
        .admin-brand-icon {
            width: 40px;
            height: 40px;
            border-radius: .75rem;
            background: var(--admin-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }
        .admin-sidebar .nav-link {
            color: var(--admin-sidebar-muted);
            border-radius: .65rem;
            margin-bottom: .25rem;
            font-weight: 600;
            padding: .72rem .85rem;
        }
        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            background: rgba(255, 255, 255, .08);
            color: #fff;
        }
        .admin-content { min-height: 100vh; }
        .admin-topbar {
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .stat-card {
            border: 0;
            border-radius: .85rem;
            box-shadow: 0 .35rem 1.2rem rgba(15, 23, 42, .06);
        }

        @@media (min-width: 768px) {
            .admin-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                width: 25%;
                overflow-y: auto;
                z-index: 20;
            }

            .admin-content {
                margin-left: 25%;
                width: 75%;
            }
        }

        @@media (min-width: 992px) {
            .admin-sidebar {
                width: 16.666667%;
            }

            .admin-content {
                margin-left: 16.666667%;
                width: 83.333333%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row g-0 admin-shell">
            <aside class="col-12 col-md-3 col-lg-2 p-3 admin-sidebar">
                <a class="admin-brand" href="/admin/dashboard">
                    <span class="admin-brand-icon">SW</span>
                    <span>
                        <span class="d-block fw-bold">Swings House</span>
                        <small class="text-white-50">Admin Console</small>
                    </span>
                </a>

                <nav class="nav flex-column">
                    <a class="nav-link @Active("/admin/dashboard")" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>T&#7893;ng quan</a>
                    <a class="nav-link @Active("/admin/users")" href="/admin/users"><i class="bi bi-people me-2"></i>Ng&#432;&#7901;i d&#249;ng</a>
                    <a class="nav-link @Active("/admin/listing-management")" href="/admin/listing-management"><i class="bi bi-card-list me-2"></i>Tin &#273;&#259;ng</a>
                    <a class="nav-link @Active("/admin/listings")" href="/admin/listings"><i class="bi bi-house-door me-2"></i>Duy&#7879;t tin</a>
                    <a class="nav-link @Active("/admin/revenue")" href="/admin/revenue"><i class="bi bi-cash-coin me-2"></i>Doanh thu</a>
                    <a class="nav-link @Active("/admin/reports")" href="/admin/reports"><i class="bi bi-flag me-2"></i>B&#225;o c&#225;o</a>
                    <a class="nav-link @Active("/admin/storage")" href="/admin/storage"><i class="bi bi-cloud-arrow-up me-2"></i>Kho &#7843;nh</a>
                    <a class="nav-link @Active("/admin/amenities")" href="/admin/amenities"><i class="bi bi-list-ul me-2"></i>Tiện ích</a>
                    <a class="nav-link @Active("/admin/notifications/send")" href="/admin/notifications/send"><i class="bi bi-bell me-2"></i>Gửi thông báo</a>
                    <a class="nav-link" href="/swagger"><i class="bi bi-braces me-2"></i>Swagger API</a>
                </nav>
            </aside>

            <div class="col-12 col-md-9 col-lg-10 admin-content">
                <header class="admin-topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
                    <h1 class="h5 mb-0">@pageTitle</h1>

                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted">Xin ch&#224;o, <strong>@adminName</strong></span>
                        <form method="post" action="/auth/logout" class="m-0">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>&#272;&#259;ng xu&#7845;t
                            </button>
                        </form>
                    </div>
                </header>

                <main class="p-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Backend_API.Models.ViewModels.Admin.AdminListingsViewModel
@{
    ViewData["Title"] = "Duyệt Tin Đăng";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Danh sách pending</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#ID</th>
                        <th>Tiêu đề</th>
                        <th>Giá</th>
                        <th>Chủ tin</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Listings.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Không có tin pending.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var listing in Model.Listings)
                        {
                            <tr>
                                <td>@listing.ListingId</td>
                                <td>@listing.Title</td>
                                <td>@listing.Price.ToString("N0") đ</td>
                                <td>
                                    <div>@listing.LandlordName</div>
                                    <small class="text-muted">@(listing.LandlordEmail ?? "-")</small>
                                </td>
                                <td>@(listing.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <form method="post" action="/admin/listings/@listing.ListingId/approve">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                        </form>
                                        <form method="post" action="/admin/listings/@listing.ListingId/reject" class="d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Lý do từ chối" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

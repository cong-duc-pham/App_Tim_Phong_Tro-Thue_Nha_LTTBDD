@model Backend_API.Models.ViewModels.Admin.AdminListingManagementViewModel
@{
    ViewData["Title"] = "Quản lý tin đăng";
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" action="/admin/listing-management" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tiêu đề, địa chỉ, chủ tin..." />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status" selected="@(string.Equals(Model.Status, status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-5">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a href="/admin/listing-management" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Danh sách tin đăng</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#ID</th>
                        <th>Preview</th>
                        <th>Tin đăng</th>
                        <th>Giá</th>
                        <th>Chủ tin</th>
                        <th>Trạng thái</th>
                        <th>Lượt xem</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Listings.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Không có tin đăng phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var listing in Model.Listings)
                        {
                            <tr>
                                <td>@listing.ListingId</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(listing.Image0))
                                    {
                                        <img src="@listing.Image0" alt="@listing.Title" class="rounded border object-fit-cover" style="width: 76px; height: 52px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@listing.Title</div>
                                    <small class="text-muted">#@listing.ListingId</small>
                                </td>
                                <td>@listing.Price.ToString("N0") đ</td>
                                <td>
                                    <div>@listing.LandlordName</div>
                                    <small class="text-muted">@(listing.LandlordEmail ?? "-")</small>
                                </td>
                                <td><span class="badge text-bg-secondary">@listing.StatusName</span></td>
                                <td>@(listing.ViewCount ?? 0)</td>
                                <td>@(listing.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a href="/admin/listings/@listing.ListingId" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        @if (string.Equals(listing.StatusName, "pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post" action="/admin/listings/@listing.ListingId/approve">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">Duyệt</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

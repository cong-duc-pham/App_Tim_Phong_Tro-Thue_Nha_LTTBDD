@model Backend_API.Models.ViewModels.Admin.AdminListingDetailViewModel
@{
    ViewData["Title"] = "Chi ti\u1EBFt tin \u0111\u0103ng";
    var fullAddress = string.Join(", ", new[]
    {
        Model.StreetAddress,
        Model.WardName,
        Model.DistrictName,
        Model.ProvinceName
    }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

@if (TempData["AdminSuccess"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["AdminError"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="@(Model.IsManagementContext ? "/admin/listing-management" : "/admin/listings")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay l&#7841;i
    </a>
    @if (!Model.IsManagementContext)
    {
        <div class="d-flex gap-2">
            <form method="post" action="/admin/listings/@Model.ListingId/approve" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-circle me-1"></i>Duy&#7879;t tin
                </button>
            </form>
            <form method="post" action="/admin/listings/@Model.ListingId/reject" class="d-flex gap-2 m-0">
                @Html.AntiForgeryToken()
                <input type="text" name="reason" class="form-control" style="width: 280px;" placeholder="L&#253; do t&#7915; ch&#7889;i" />
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>T&#7915; ch&#7889;i
                </button>
            </form>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <div>
                        <div class="text-muted small">#@Model.ListingId - @Model.StatusName</div>
                        <h2 class="h4 mb-2">@Model.Title</h2>
                        <div class="text-muted">
                            <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(fullAddress) ? "-" : fullAddress)
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fs-4 fw-bold text-primary">@Model.Price.ToString("N0") &#273;</div>
                        <div class="text-muted small">@Model.Area.ToString("N1") m&#178;</div>
                    </div>
                </div>

                @if (Model.ImageUrls.Any())
                {
                    <div class="row g-2 mb-4">
                        @foreach (var imageUrl in Model.ImageUrls)
                        {
                            <div class="col-6 col-md-4">
                                <a href="@imageUrl" target="_blank" rel="noopener">
                                    <img src="@imageUrl" alt="Listing image" class="img-fluid rounded border object-fit-cover w-100" style="height: 180px;" />
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-4">
                        Tin n&#224;y ch&#432;a c&#243; &#7843;nh b&#236;a. Tin s&#7869; kh&#244;ng th&#7875; duy&#7879;t cho &#273;&#7871;n khi c&#243; &#7843;nh.
                    </div>
                }

                <h3 class="h6">M&#244; t&#7843;</h3>
                <p class="mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Chua co mo ta." : Model.Description)</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Video</div>
            <div class="card-body">
                @if (Model.Videos.Any())
                {
                    <div class="row g-3">
                        @foreach (var video in Model.Videos)
                        {
                            <div class="col-12 col-md-6">
                                <video src="@video.Url" controls class="w-100 rounded border bg-dark" style="max-height: 260px;"></video>
                                <div class="small text-muted mt-1">
                                    #@video.VideoId
                                    @if (video.FileSizeKb != null)
                                    {
                                        <span>- @video.FileSizeKb KB</span>
                                    }
                                    @if (video.CreatedAt != null)
                                    {
                                        <span>- @video.CreatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">Tin này chưa có video.</span>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Ti&#7879;n &#237;ch</div>
            <div class="card-body">
                @if (Model.Amenities.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <span class="badge text-bg-light border">@amenity</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">Ch&#432;a c&#243; ti&#7879;n &#237;ch.</span>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Th&#244;ng tin ph&#242;ng</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Lo&#7841;i</dt>
                    <dd class="col-7">@Model.RoomType</dd>
                    <dt class="col-5">T&#7847;ng</dt>
                    <dd class="col-7">@(Model.Floor?.ToString() ?? "-") / @(Model.TotalFloors?.ToString() ?? "-")</dd>
                    <dt class="col-5">S&#7889; ng&#432;&#7901;i</dt>
                    <dd class="col-7">@(Model.MaxOccupants?.ToString() ?? "-")</dd>
                    <dt class="col-5">Th&#250; c&#432;ng</dt>
                    <dd class="col-7">@(Model.AllowPet == true ? "Cho ph&#233;p" : "Kh&#244;ng/Ch&#432;a r&#245;")</dd>
                    <dt class="col-5">C&#243; s&#7861;n t&#7915;</dt>
                    <dd class="col-7">@(Model.AvailableFrom?.ToString("dd/MM/yyyy") ?? "-")</dd>
                    <dt class="col-5">H&#7871;t h&#7841;n</dt>
                    <dd class="col-7">@(Model.ExpiredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-5">L&#432;&#7907;t xem</dt>
                    <dd class="col-7">@(Model.ViewCount ?? 0)</dd>
                    <dt class="col-5">L&#432;&#7907;t l&#432;u</dt>
                    <dd class="col-7">@(Model.SaveCount ?? 0)</dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Chi ph&#237; d&#7883;ch v&#7909;</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">&#272;i&#7879;n</dt>
                    <dd class="col-7">@(Model.ElectricPrice?.ToString("N0") ?? "-")</dd>
                    <dt class="col-5">N&#432;&#7899;c</dt>
                    <dd class="col-7">@(Model.WaterPrice?.ToString("N0") ?? "-")</dd>
                    <dt class="col-5">Internet</dt>
                    <dd class="col-7">@(Model.InternetPrice?.ToString("N0") ?? "-")</dd>
                    <dt class="col-5">Gi&#7919; xe</dt>
                    <dd class="col-7">@(Model.ParkingPrice?.ToString("N0") ?? "-")</dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">G&#243;i VIP / Tin n&#7893;i b&#7853;t</div>
            <div class="card-body">
                @if (Model.Packages.Any())
                {
                    @foreach (var package in Model.Packages)
                    {
                        <div class="border rounded p-3 mb-3 @(package.IsActive ? "border-primary" : "")">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <div class="fw-semibold">@package.PackageName</div>
                                    <div class="text-muted small">@package.PackageType - @package.Price.ToString("N0") &#273;</div>
                                </div>
                                <span class="badge @(package.IsActive ? "text-bg-primary" : "text-bg-secondary")">
                                    @(package.IsActive ? "Đang hiệu lực" : "Không hiệu lực")
                                </span>
                            </div>
                            <dl class="row mb-0 small">
                                <dt class="col-5">Thời hạn</dt>
                                <dd class="col-7">@package.StartDate.ToLocalTime().ToString("dd/MM/yyyy") - @package.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                                <dt class="col-5">Ưu tiên</dt>
                                <dd class="col-7">@package.Priority</dd>
                                <dt class="col-5">Ảnh / Video</dt>
                                <dd class="col-7">@package.MaxImages ảnh / @package.MaxVideos video</dd>
                                <dt class="col-5">Banner</dt>
                                <dd class="col-7">@(package.AllowBanner ? "Có" : "Không")</dd>
                                <dt class="col-5">Badge</dt>
                                <dd class="col-7">@(package.BadgeType ?? "-")</dd>
                                <dt class="col-5">Thống kê</dt>
                                <dd class="col-7">@(package.HasAnalytics ? "Có" : "Không")</dd>
                                <dt class="col-5">Nổi bật</dt>
                                <dd class="col-7">@(package.IsHighlighted ? "Có" : "Không")</dd>
                                <dt class="col-5">Thanh toán</dt>
                                <dd class="col-7">
                                    @(package.PaymentId?.ToString() ?? "-")
                                    @if (!string.IsNullOrWhiteSpace(package.PaymentStatus))
                                    {
                                        <span class="text-muted">(@package.PaymentStatus)</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">Tin này chưa mua gói VIP hoặc Tin nổi bật.</div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Ng&#432;&#7901;i &#273;&#259;ng</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">T&#234;n</dt>
                    <dd class="col-7">@Model.LandlordName</dd>
                    <dt class="col-5">Email</dt>
                    <dd class="col-7">@(Model.LandlordEmail ?? "-")</dd>
                    <dt class="col-5">S&#272;T</dt>
                    <dd class="col-7">@(Model.LandlordPhone ?? "-")</dd>
                    <dt class="col-5">Firebase UID</dt>
                    <dd class="col-7 text-break">@(Model.LandlordFirebaseUid ?? "-")</dd>
                    <dt class="col-5">Ng&#224;y t&#7841;o</dt>
                    <dd class="col-7">@(Model.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-5">C&#7853;p nh&#7853;t</dt>
                    <dd class="col-7">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

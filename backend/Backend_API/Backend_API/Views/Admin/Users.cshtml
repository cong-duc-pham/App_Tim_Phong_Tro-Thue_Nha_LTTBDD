@model Backend_API.Models.ViewModels.Admin.AdminUsersViewModel
@{
    ViewData["Title"] = "Quản lý Users";
}

@if (TempData["AdminSuccess"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["AdminError"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <div class="fw-semibold">Danh sách Users</div>
            <div class="small text-muted">Role được tự xác định theo tin đăng: chưa đăng tin là tenant, đã đăng tin là landlord.</div>
        </div>
        <form method="post" action="/admin/users/sync-firebase" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-primary">Đồng bộ Firebase users</button>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>firebase_uid</th>
                        <th>auth_method</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@user.RoleName</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(user.FirebaseUid))
                                    {
                                        <span class="badge bg-secondary">Không</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Có</span>
                                    }
                                </td>
                                <td>@user.AuthMethod</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/admin/notifications/send?targetUserId=@user.UserId" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-bell-fill"></i> Thông báo
                                    </a>
                                    <form method="post" action="/admin/users/@user.UserId/toggle-active" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Khóa</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">Mở khóa</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

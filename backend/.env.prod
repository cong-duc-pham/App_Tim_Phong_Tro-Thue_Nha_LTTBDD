# =========================
# PhongTro API - Production
# =========================

# Public API port on host
API_PORT=5000

# ===== Database =====
ConnectionStrings__DefaultConnection=Server=host.docker.internal,1434;Database=PhongTroDB;User Id=sa;Password=REPLACE_WITH_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=False

# ===== JWT =====
JwtSettings__SecretKey=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS
JwtSettings__Issuer=PhongTroAPI
JwtSettings__Audience=PhongTroApp
JwtSettings__ExpireHours=24

# ===== Firebase =====
Firebase__ProjectId=app-tim-phong-tro-thue-n-dacfe
Firebase__StorageBucket=app-tim-phong-tro-thue-n-dacfe.appspot.com
# File path on host machine (absolute path recommended on Windows)
FIREBASE_CREDENTIAL_FILE=C:\\path\\to\\firebase-adminsdk.json
Firebase__CredentialPath=/app/secrets/firebase-adminsdk.json

# ===== API runtime =====
Swagger__Enabled=true
Cors__AllowedOrigins__0=https://your-production-domain.com

# Optional additional allowed origins
# Cors__AllowedOrigins__1=https://admin.your-production-domain.com
Cloudinary__CloudName=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=REPLACE_WITH_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=REPLACE_WITH_CLOUDINARY_API_SECRET

Cloudinary__UploadPreset=phongtro_unsigned
Cloudinary__ListingUploadPreset=phongtro_listing_unsigned
Cloudinary__AvatarUploadPreset=phongtro_avatar_unsigned
Cloudinary__ChatUploadPreset=phongtro_chat_unsigned
